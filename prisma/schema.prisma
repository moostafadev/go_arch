generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String?
  course    String
  message   String?
  status    String   @default("New")
  createdAt DateTime @default(now())
}

model Sale {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  customerName String
  course       String
  amount       String
  phone        String?
  email        String?
  createdAt    DateTime @default(now())
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]
}

model Course {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String   @unique
  desc          String
  price         String
  discountPrice String?
  hours         String?
  image         String
  categoryId    String   @db.ObjectId
  category      Category @relation(fields: [categoryId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}