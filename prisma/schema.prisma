generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type SocialLink {
  platform String
  url      String
  label    String?
}

model Lead {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String?
  course    String
  message   String?
  status    String   @default("New")
  sales     Sale[]
  createdAt DateTime @default(now())
}

model Sale {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  customerName String
  amount       String
  phone        String?
  email        String?
  leadId       String?      @db.ObjectId
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  courses      SaleCourse[]
  createdAt    DateTime     @default(now())

  @@index([leadId])
}

model SaleCourse {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  saleId   String @db.ObjectId
  courseId String @db.ObjectId
  sale     Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id])

  @@unique([saleId, courseId])
  @@index([courseId])
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]
}

model Course {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String       @unique
  desc          String
  price         String
  discountPrice String?
  hours         String?
  image         String
  categoryId    String       @db.ObjectId
  category      Category     @relation(fields: [categoryId], references: [id])
  sales         SaleCourse[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model PageView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ipHash    String
  path      String
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([ipHash, path, createdAt])
}

model SeoSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  pageKey     String   @unique
  title       String
  description String
  keywords    String[]
  image       String?
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  key       String       @unique
  phone     String?
  email     String?
  socials   SocialLink[]
  updatedAt DateTime     @updatedAt
}

model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  role      String
  text      String
  image     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model SiteImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  url       String?
  updatedAt DateTime @updatedAt
}

model StudentWork {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  image     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Faq {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}